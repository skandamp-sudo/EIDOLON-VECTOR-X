#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
if [ "$#" -ne 1 ] || [ -z "$1" ]; then
  echo 'Usage: scripts/milestone "conventional commit message"' >&2
  exit 2
fi
if git diff --cached --quiet; then
  echo 'Stage the specific milestone files first.' >&2
  exit 1
fi
if ! git diff --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
  echo 'Verification requires the working files to match the staged snapshot.' >&2
  exit 1
fi
./scripts/verify
git diff --quiet && git commit -m "$1"
